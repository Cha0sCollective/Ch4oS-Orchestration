{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "outDir": "dist", "rootDir": "src",
    "declaration": true, "sourceMap": true, "skipLibCheck": true, "types": ["node"],
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
