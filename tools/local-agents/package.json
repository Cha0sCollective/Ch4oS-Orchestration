{
  "name": "@ch4os/local-agents",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Bounded local inference workers for Codex orchestration",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "ch4os-local-agents": "dist/cli.js",
    "ch4os-web-search": "dist/search-cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SEARCH.md",
    "examples",
    "catalog",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "qualify": "npm run build && node dist/qualify.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
